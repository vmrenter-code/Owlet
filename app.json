{
  "expo": {
    "name": "owlet",
    "slug": "owlet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "bundleIdentifier": "com.victorrenteria.owlet",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Neuroscreen uses the camera so you can align your child for screening.",
        "NSMicrophoneUsageDescription": "Neuroscreen uses the microphone to record audio during screening videos.",
        "NSBluetoothAlwaysUsageDescription": "App needs Bluetooth to connect to Polar H9 heart rate sensor.",
        "NSBluetoothPeripheralUsageDescription": "App needs Bluetooth to connect to Polar H9 heart rate sensor.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.398374460192-q5umdtk9qkcueu62fhg859v44kr6jate"
            ]
          }
        ]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.victorrenteria.owlet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "react-native-ble-plx"
    ],
    "extra": {
      "eas": {
        "projectId": "9d727c89-f399-4f30-8378-ffe09aa08fe5"
      }
    }
  }
}
