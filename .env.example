# Firebase (client — already used by Expo)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# API (optional — app auto-detects Metro host in dev)
# EXPO_PUBLIC_API_BASE_URL=http://YOUR_MAC_IP:4000

# Backend (required to save child profiles to your account)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Firebase Admin — download from Firebase Console → Project settings → Service accounts
# Place file at src/config/firebase-service-account.json
# Or set path / inline JSON:
# FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
